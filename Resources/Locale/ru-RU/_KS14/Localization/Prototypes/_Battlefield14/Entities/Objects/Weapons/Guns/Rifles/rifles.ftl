ent-BF14WeaponRifleDEG36C = G36C
    .desc = Пластиковое чудо, или «пластиш фантастиш», если вы немец... или дойч. Принимает магазины образца G36.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleDEG36CSupp = G36C С ГЛУШ.
    .desc = { ent-BF14WeaponRifleDEG36C.desc }

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleGBLeeEnfield = Lee–Enfield No. 1 Mk III
    .desc = Объективно лучшая винтовка с продольно-скользящим затвором обеих мировых войн. Под .303 British — или 7,7x56 мм R, если вы очень любите метрическую систему.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleGBL1A1 = L1A1
    .desc = Вариант FN FAL для Содружества: без автоматического огня и сделан в дюймах, а не в метрах, поэтому ему нужны собственные магазины. Принимает магазины образца L1A1.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUSKS = СКС Симонова
    .desc = Старый самозарядный карабин, созданный и принятый сразу после Второй мировой. Вскоре его сменил АК-47.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUOPSKS = ОП-СКС Симонова
    .desc = СКС с креплением под прицел для гражданского охотничьего рынка.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUASVAL = АС «Вал»
    .desc = Особая спецназовская винтовка «пш-пш-пш, ТЫ, БЛЯТЬ, ТРУП». Принимает магазины образца АС «Вал».

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUSR3M = СР-3М
    .desc = По сути, укороченный АС «Вал» без глушителя — для спецназа и скрытого ношения. Принимает магазины образца АС «Вал».

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUSR3MShort =
    .desc = { ent-BF14WeaponRifleRUSR3M.desc }
    .suffix = магазин на 20 патронов

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUASH12 = ШАК-12
    .desc = Ранее известный как АШ-12. Создан, чтобы дать максимум огневой мощи в ближнем бою, и даёт её чудовищным патроном 12,7x55. Принимает магазины образца АШ-12.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUASH12Suppressed = ШАК-12 С ГЛУШ.
    .desc = Ранее известный как АШ-12. Создан, чтобы дать максимум огневой мощи в ближнем бою, и даёт её чудовищным патроном 12,7x55. Глушитель здесь не для скрытности, а из милосердия — чтобы вы не выжгли себе глаза, пока чей-то череп принимает форму каноэ. Принимает магазины образца АШ-12.
