# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\SupportWeapons\AutomaticRifles.yml
ent-BF14WeaponRifleDEMG36 = MG36
    .desc = G36 с утяжелённым стволом, (обычно) сдвоенным барабанным магазином и меньшей склонностью плавиться при долгой стрельбе. Принимает магазины образца G36.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\SupportWeapons\AutomaticRifles.yml
ent-BF14WeaponRifleRURPK2016 = РПК-2016
    .desc = Модернизированный РПК-74 с просто «более крутой» фурнитурой и более современным производством, что не очень-то сказывается на эффективности. 2016 — год разработки. Принимает магазины образца АК-74.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\SupportWeapons\AutomaticRifles.yml
ent-BF14WeaponRifleRURPK74 = РПК-74
