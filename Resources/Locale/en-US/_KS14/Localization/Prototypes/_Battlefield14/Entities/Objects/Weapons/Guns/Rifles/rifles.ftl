# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleGBLeeEnfield = Lee–Enfield No. 1 Mk III
    .desc = Objectively the best bolt-action rifle of both world wars. Chambered in .303 british, or 7.7x56mmR if you really like metric.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleGBL1A1 = L1A1
    .desc = The commonwealth variation of the FN FAL, removing the full auto capability and manufactured using imperial measurements instead of metric, meaning it requires its own proprietary magazines. Takes L1A1 pattern magazines.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUSKS = SKS Simonov
    .desc = A old self loading rifle designed and adapted right after world war 2. It was replaced not too long after with the AK-47.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUOPSKS = OP-SKS Simonov
    .desc = A SKS with a scope mount made for the civilian hunter market.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUASVAL = AS-VAL
    .desc = The special spetznaz psh psh psh YOU'RE FUCKING DEAD rifle. Takes AS-VAL pattern magazines.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
ent-BF14WeaponRifleRUSR3M = SR-3M
    .desc = Essentially a chopped down AS-VAL without a suppressor for special forces and concealed carry. Takes AS-VAL pattern magazines.

# Resources\Prototypes\_Battlefield14\Entities\Objects\Weapons\Guns\Rifles\rifles.yml
