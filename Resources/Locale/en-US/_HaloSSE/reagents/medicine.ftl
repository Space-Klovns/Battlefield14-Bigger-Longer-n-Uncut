reagent-name-biofoam = Biofoam
reagent-desc-biofoam = A thick foam that expands inside the body to fill wound cavities and support/repair damaged organs while also stemming bleeding. Risk of rejection is NEAR zero.

reagent-name-biofoam-remnants = biofoam remnants
